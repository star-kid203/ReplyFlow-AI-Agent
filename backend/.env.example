# ==============================================================================
# REPLYFLOW OPERATIONS PLATFORM — ENVIRONMENT CONFIGURATION
# Open Agent Hackathon 2026 (GenAI.works)
# Note: Keep secrets in local .env only. Never commit live keys to GitHub.
# ==============================================================================

PROJECT_NAME="ReplyFlow Operations API"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Runtime Flags
SAMPLE_MODE=true
LOG_LEVEL=INFO
PORT=8000


# Database (PostgreSQL 16 Alpine via Docker port 5433)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=replyflow
POSTGRES_PASSWORD=replyflow_secret
POSTGRES_DB=replyflow_db


# Model Provider Layer (Meterless Nightshift & NVIDIA Nemotron)
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=your-meterless-or-nvidia-key
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_RUNTIME_TOKEN=your-meterless-runtime-token
LLM_PROVIDER=meterless

# Optional Fallback Model Provider
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Zetaris Lightning Data Fabric Layer
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key-here
ZETARIS_HOST=localhost
ZETARIS_PORT=10000
